# Copy to .env (git-ignored) and adjust. Every variable is read by backend/app/core/config.py.

# Required. The database the API and Alembic use. Matches infra/docker-compose.yml.
NEXTPAY_DATABASE_URL=postgresql+psycopg://nextpay:nextpay@localhost:5432/nextpay

# Optional. Log every SQL statement (default false).
NEXTPAY_SQL_ECHO=false

# Tests only. A database the test suite may drop and recreate; database tests
# skip when this is unset. The tests create it on the server they find.
NEXTPAY_TEST_DATABASE_URL=postgresql+psycopg://nextpay:nextpay@localhost:5432/nextpay_test
